# PEM-encoded PKCS8 Ed25519 private key used to sign requests. Required.
SIGNING_PRIVATE_KEY=

# Port the HTTP server listens on. Optional, defaults to 3000.
PORT=3000

# World ID Developer Portal app/RP identifiers and RP signing key, used to
# gate signature release behind a Selfie Check. All required. See
# https://developer.world.org
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=

# "production" or "staging" (staging talks to the World ID simulator at
# https://simulator.worldcoin.org/). Optional, defaults to production.
WORLD_ENVIRONMENT=production

# Whether POST /sign/:requestId requires a valid AgentKit "agentkit" header
# resolving to a human registered in AgentBook.
# - enforce: reject requests without a valid human-backed agent header
# - warn:    log the outcome but let the request through
# - off:     skip the check entirely
# Optional, defaults to enforce.
WORLD_AGENTKIT=enforce
